# Base URL of the Click-Star Express API (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000/api
# "live" talks to the API above. "mock" runs a fully in-browser demo backend.
VITE_API_MODE=live
# "browser" for clean URLs (needs SPA fallback on the host), "hash" for static/iframe hosting
VITE_ROUTER=browser
