PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRE=7d
# Comma-separated list of allowed frontend origins (leave empty to allow all in development)
CORS_ORIGIN=http://localhost:5173
# Optional public URL of this API, used to build links for locally stored uploads
PUBLIC_URL=http://localhost:5000
# Cloudinary (optional — if unset, uploads are stored on disk in ./uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
